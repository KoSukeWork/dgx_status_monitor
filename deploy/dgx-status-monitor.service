[Unit]
Description=DGX GB10 status monitor
After=network.target

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=-/etc/default/dgx-status-monitor
ExecStart=/opt/dgx-status-monitor/.venv/bin/dgx-status-monitor
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
